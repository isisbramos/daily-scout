# Copie este arquivo para .env e preencha com suas chaves reais
# cp .env.example .env

# DeepSeek — obtenha em: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sua_chave_aqui

# Buttondown (entrega da newsletter)
BUTTONDOWN_API_KEY=sua_chave_aqui

# Opcionais
EDITION_NUMBER=001
DRY_RUN=false
SOCIAL_ENABLED=false
DEBUG_SAVE=false

# Judge opcional (audit_agent.py) — só preencha se quiser usar um modelo/provedor
# diferente da curadoria. Sem isso, o audit usa o mesmo DeepSeek de cima.
# Exemplo com Gemini (chave em https://aistudio.google.com/apikey):
# AUDIT_API_KEY=sua_chave_gemini_aqui
# AUDIT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AUDIT_MODEL=gemini-3.5-flash-lite
