.DS_Store
site-v2/

# Previews & screenshots (nunca vão pro repo)
*-preview.html
*-preview.png
preview_*.html
preview_*.png

# Sandbox/scratch dirs com timestamp
ramosdisis-*/
sandbox-*/
scratch-*/

# Local tooling & scratch (não vão pro repo)
.claude/
uploads/

# Docs exportados (binários)
*.docx
*.pdf

# Vault bridge (Stage B) — estado local de sync, específico de cada máquina.
.vault_sync_state.json
